#!/usr/bin/env bash
#MISE description="First-time setup: initialize env, install frontend dependencies, hooks, and database"

set -euo pipefail

[ -f .env ] || cp .env.example .env
[ -f packages/email/.dev.vars ] || cp packages/email/.dev.vars.example packages/email/.dev.vars
mise run frontend:install
prek install
mise run generate
mise run db:up
mise run db:wait
mise run backend:migrate
mise run backend:seed
mise run db:down
