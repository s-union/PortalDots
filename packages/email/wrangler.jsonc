{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "email",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-02",
  // Required for `vite dev`'s workerd environment to boot: it statically
  // resolves hono-email's un-bundled dependency graph, which references a
  // couple of Node built-ins (tty, util) pre-bundling. The production
  // `vite build` output does not itself import Node built-ins, but this
  // flag is kept so `vite dev` keeps working.
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "email-idempotency",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "email-high",
        "binding": "HIGH_QUEUE"
      },
      {
        "queue": "email-normal",
        "binding": "NORMAL_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "email-high",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5
      },
      {
        "queue": "email-normal",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 5
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
