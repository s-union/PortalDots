{
  "name": "@portaldots/email",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --config vite.worker.config.ts --port 8787",
    "dev:local-stack": "wrangler d1 migrations apply email-idempotency --local --persist-to .wrangler/state && vite dev --config vite.worker.config.ts --port 8787",
    "deploy": "vite build --config vite.worker.config.ts && wrangler deploy",
    "preview": "hono-email preview --dir src/templates",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "ci:check": "$npm_execpath run typecheck && $npm_execpath run lint && $npm_execpath run format:check",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.12.25",
    "hono-email": "0.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/workers-types": "4.20260608.1",
    "@hono-email/preview": "0.7.0",
    "@hono-email/tailwind-plugin": "0.7.0",
    "@tailwindcss/vite": "4.3.2",
    "tailwindcss": "4.3.2",
    "typescript": "^7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.8",
    "wrangler": "4.110.0"
  }
}
